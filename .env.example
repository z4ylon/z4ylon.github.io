# Dominio definitivo (sitemap, URLs canónicas y Open Graph)
SITE_URL=https://www.tudominio.com

# Endpoint del formulario de contacto (Formspree, Web3Forms, Getform… cualquiera que acepte POST JSON).
# Si se deja vacío, el formulario abre el cliente de correo del visitante con el mensaje ya redactado.
PUBLIC_FORM_ENDPOINT=
