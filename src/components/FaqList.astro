---
import Icon from './Icon.astro';
import type { Faq } from '@/data/site';

interface Props {
  items: Faq[];
  /** Nivel del título de cada pregunta */
  headingLevel?: 'h3' | 'h4';
  compact?: boolean;
}
const { items, headingLevel = 'h3', compact = false } = Astro.props;
const H = headingLevel;
---

<div class:list={['faq', compact && 'faq--compact']}>
  {
    items.map((f) => (
      <details class="faq__item" name={compact ? undefined : 'faq'}>
        <summary>
          <H class="faq__q">{f.q}</H>
          <span class="faq__icon" aria-hidden="true">
            <Icon name="plus" size={18} />
          </span>
        </summary>
        <div class="faq__a">
          {f.a.map((p) => (
            <p>{p}</p>
          ))}
        </div>
      </details>
    ))
  }
</div>
