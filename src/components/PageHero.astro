---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imagePosition?: string;
  sections?: { href: string; label: string }[];
}
const { eyebrow, title, lead, image, imageAlt = '', imagePosition = 'center', sections } = Astro.props;
---

<section class="page-hero grain" aria-labelledby="page-title">
  {
    image && (
      <div class="page-hero__bg" aria-hidden={imageAlt ? undefined : 'true'}>
        <Image src={image} alt={imageAlt} widths={[640, 1024, 1600, 2000]} sizes="100vw" loading="eager" fetchpriority="high" layout="full-width" style={`object-position:${imagePosition}`} />
      </div>
    )
  }
  <div class="page-hero__pattern" aria-hidden="true"></div>
  <div class="container page-hero__content">
    <p class="eyebrow">{eyebrow}</p>
    <h1 id="page-title" class="display" set:html={title} />
    {lead && <p class="lead">{lead}</p>}
    <slot />
    {
      sections && (
        <nav class="page-hero__toc" aria-label="En esta página">
          <ul role="list">
            {sections.map((s) => (
              <li>
                <a href={s.href}>{s.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</section>
